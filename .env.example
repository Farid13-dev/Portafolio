# ============================================================
# VARIABLES DE ENTORNO
# Copia este archivo a .env y completa los valores.
# En Vercel: Settings → Environment Variables (Production y Preview).
# En GitHub: Settings → Secrets → Actions (DATABASE_URL y DIRECT_URL) para que el CI pueda hacer el build.
# ============================================================

# --- Base de datos (PostgreSQL, p. ej. Supabase) ---
# Conexión con pooling (puerto 6543): la usa la app en runtime
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432): la usan prisma db push / migrate
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# --- Sitio ---
# Dominio público con https. Se usa para metadata, sitemap.xml, robots.txt y la imagen Open Graph.
# Si no se define, en Vercel se usa VERCEL_PROJECT_PRODUCTION_URL y en local http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"

# --- Formulario de contacto (Resend) ---
RESEND_API_KEY="re_xxxxxxxxx"
# Buzón que recibe los mensajes
CONTACT_EMAIL="tu@email.com"
# Remitente. "onboarding@resend.dev" solo entrega al dueño de la cuenta Resend:
# en producción usa un dominio verificado en Resend, p. ej. "Portafolio <hola@tu-dominio.com>"
CONTACT_FROM="Portafolio <onboarding@resend.dev>"
