# ============================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ============================================================

# ------------------------------------------------------------
# BASE DE DATOS
# ------------------------------------------------------------

# Para desarrollo local con SQLite (Windows)
DATABASE_URL=file:./db/custom.db

# Para desarrollo con PostgreSQL (opcional)
# DATABASE_URL="postgresql://usuario:password@localhost:5432/miportafolio"

# Para producción con PostgreSQL (ejemplo con Supabase)
# DATABASE_URL="postgresql://postgres:password@db.tu-proyecto.supabase.co:5432/postgres"

# ------------------------------------------------------------
# APLICACIÓN
# ------------------------------------------------------------

# Entorno de ejecución
NODE_ENV=development

# Puerto del servidor (Next.js usa 3000 por defecto)
PORT=3000

# ------------------------------------------------------------
# NEXTAUTH (Opcional - para autenticación)
# ------------------------------------------------------------

# URL de tu aplicación en producción
# NEXTAUTH_URL="http://localhost:3000"

# Secreto para encriptar sesiones
# Genera uno con: openssl rand -base64 32
# NEXTAUTH_SECRET="tu-secreto-aleatorio-aqui"
